<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#FDD9">

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JoKenPo"
        android:textAlignment="center"
        android:textColor="#F052"
        android:textSize="35sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.195" />

    <TextView
        android:id="@+id/textResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escolha a sua opção"
        android:textAlignment="center"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/padrao"
        app:layout_constraintVertical_bias="0.225" />

    <ImageView
        android:id="@+id/padrao"
        android:layout_width="172dp"
        android:layout_height="164dp"
        android:layout_marginBottom="344dp"
        android:scaleType="centerInside"
        android:src="@drawable/padrao"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textTitle"
        app:layout_constraintVertical_bias="0.626" />


    <ImageView
        android:id="@+id/paper"
        android:layout_width="107dp"
        android:layout_height="106dp"
        android:layout_marginStart="28dp"
        android:scaleType="centerInside"
        android:src="@drawable/papel"
        android:onClick="slectPapel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textResultado" />

    <ImageView
        android:id="@+id/tesoura"
        android:layout_width="107dp"
        android:layout_height="106dp"
        android:layout_marginStart="32dp"
        android:scaleType="centerInside"
        android:src="@drawable/tesoura"
        android:onClick="selectTesoura"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/paper"
        app:layout_constraintTop_toBottomOf="@+id/textResultado" />

    <ImageView
        android:id="@+id/pedra"
        android:layout_width="107dp"
        android:layout_height="106dp"
        android:scaleType="centerInside"
        android:src="@drawable/pedra"
        android:onClick="selectPedra"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tesoura"
        app:layout_constraintTop_toBottomOf="@+id/textResultado" />


</androidx.constraintlayout.widget.ConstraintLayout>